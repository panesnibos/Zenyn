AGENT_API_KEY=
AGENT_MODELS=prem/deepseek-v4.1-flash-1017,prem/minimax-m2.7,prem/glm-5.3-flash
AGENT_BASE=https://free.ai.id/v1
AGENT_RETRY_MAX=50
AGENT_RETRY_DELAY_MS=15000
AGENT_MAX_STEPS=12
AGENT_DEADLINE_MS=900000

# LLM gateway admin API (loopback, hanya dari VPS yang sama)
GW_ADMIN_URL=http://127.0.0.1:8081
GW_ADMIN_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
APP_DIR=/root/zenyn
PM2_NAME=zenyn
BRANCH=main
# .iqc: engine chromium (render SPA 3scode/iqc-generator) dengan batas CPU
IQC_ENGINE=chromium
IQC_CPU_PERCENT=70
IQC_LOAD_MAX=0.7
IQC_SCALE=2
IQC_TIMEOUT_MS=20000
# raid
RAID_ATTACK_CD_MS=2000
RAID_RESPAWN_MS=900000
WB_RESPAWN_MS=1800000
RAID_DEATH_MS=60000
RAID_MAX_LEVEL=200
